# ---------------------------------------------------------------------------
# 复制本文件为 .env，把 <DB_PASSWORD> 换成 Supabase 数据库密码后即可使用。
# .env 已被 .gitignore 忽略，不会进仓库。
# ---------------------------------------------------------------------------

# 运行时连接：Supabase Transaction Pooler（6543）。
# Serverless 环境下每个函数实例都会开连接，必须走连接池，
# 并且 pgbouncer 事务模式不支持预处理语句，所以要带 pgbouncer=true。
DATABASE_URL="postgresql://postgres.bxjgfzlkgktfcupkmqip:<DB_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# 迁移专用连接：直连（5432）。DDL 不能走 pgbouncer 事务池。
DIRECT_URL="postgresql://postgres:<DB_PASSWORD>@db.bxjgfzlkgktfcupkmqip.supabase.co:5432/postgres"

# 集成测试连接：同一实例的独立 schema，与开发数据互不污染。
TEST_DATABASE_URL="postgresql://postgres:<DB_PASSWORD>@db.bxjgfzlkgktfcupkmqip.supabase.co:5432/postgres?schema=test"

# Supabase 项目公开信息（anon key 设计上就是公开的）
NEXT_PUBLIC_SUPABASE_URL="https://bxjgfzlkgktfcupkmqip.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ4amdmemxrZ2t0ZmN1cGttcWlwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkwMjcyMzIsImV4cCI6MjEwNDYwMzIzMn0.8byGZqKskwtQ75MUkY0-5ZcaVHswS3xZoWalCQWD-h8"

# 模拟支付回调的签名密钥。用于校验 /api/v1/pay 的 X-Signature 头，
# 防止任何人裸调该接口把自己变成会员。本地可随意填，线上请换成强随机值。
PAY_WEBHOOK_SECRET="dev-only-change-me"

# 会话有效期（小时）
SESSION_TTL_HOURS="720"
